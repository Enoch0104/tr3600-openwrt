--- a/target/linux/mediatek/filogic/base-files/lib/upgrade/platform.sh
+++ b/target/linux/mediatek/filogic/base-files/lib/upgrade/platform.sh
@@ -338,6 +338,28 @@ platform_do_upgrade() {
 		CI_DATA_UBIPART=ubi
 		nand_do_upgrade "$1"
 		;;
+	cudy,tr3600-v1)
+		# Cudy dual-image layout: write the new firmware to the
+		# inactive (upgrade) slot and flip the boot slot flag.
+		# Volume names and slot number come from the boot_param
+		# kernel module (see 999-ubi-add-configurable-rootdev.patch).
+		local ubp="/sys/module/boot_param/parameters"
+		if [ -r "$ubp/upgrade_kernel_part" ]; then
+			CI_KERNPART="$(cat "$ubp/upgrade_kernel_part")"
+			CI_ROOTPART="$(cat "$ubp/upgrade_rootfs_part")"
+			nand_do_flash_file "$1" || nand_do_upgrade_failed
+			local slot
+			slot="$(cat "$ubp/upgrade_image_slot" 2>/dev/null)"
+			if [ -n "$slot" ]; then
+				v "Set new boot image slot to $slot"
+				fw_setenv "dual_boot.current_slot" "$slot"
+				fw_setenv "dual_boot.slot_${slot}_invalid" "0"
+			fi
+			nand_do_upgrade_success
+		else
+			nand_do_upgrade "$1"
+		fi
+		;;
 	*)
 		nand_do_upgrade "$1"
 		;;
